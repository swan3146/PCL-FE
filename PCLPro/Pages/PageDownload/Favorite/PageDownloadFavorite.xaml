<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadFavorite"
    PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,10,25,25">
                <local:MyCard x:Name="CardDownload" Title="下载到所选版本" Margin="0,0,0,15">
                    <StackPanel Margin="25,40,25,15">
                        <StackPanel x:Name="PanTypes" Orientation="Horizontal">
                            <local:MyRadioBox x:Name="TabMod" Text="Mod" Checked="True" Margin="0,0,22,0" />
                            <local:MyRadioBox x:Name="TabMap" Text="地图" Margin="0,0,22,0" />
                            <local:MyRadioBox x:Name="TabResourcePack" Text="资源包" Margin="0,0,22,0" />
                            <local:MyRadioBox x:Name="TabShader" Text="光影包" Margin="0,0,22,0" />
                            <local:MyRadioBox x:Name="TabDataPack" Text="数据包" />
                        </StackPanel>
                        <Grid Height="38" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="下载到" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock x:Name="LabInstance" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Text="未选择版本" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <local:MyButton x:Name="BtnChangeInstance" Text="选择版本" Padding="13,0" Margin="12,0,0,0" />
                                <local:MyButton x:Name="BtnDownload" Text="开始下载" ColorType="Highlight" Padding="13,0" Margin="12,0,0,0"
                                                ToolTip="把勾选的收藏下载到所选的游戏版本" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LabTip" Margin="0,12,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource ColorBrushGray3}"
                                   Text="这是一个一键下载收藏mod到上方所选版本的小功能 默认下载最新版本和依赖哦" />
                        <local:MyHint x:Name="HintNoInstance" Theme="Red" HasBorder="True" Visibility="Collapsed" Margin="0,12,0,0"
                                      Text="当前没有可用的游戏版本，请先在版本管理中安装或导入一个游戏版本。" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardItems" Title="我收藏的 Mod" UseAnimation="False">
                    <Grid Margin="12,36,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="164" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="2,0,10,0">
                            <local:MyButton x:Name="BtnAddFolder" Text="新建收藏夹" Padding="10,0" Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch" ToolTip="新建一个自定义收藏夹，把收藏自由分类整理" />
                            <local:MyScrollViewer x:Name="PanFoldersScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PanFolders" />
                            </local:MyScrollViewer>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:MyTextBox x:Name="TextSearch" Margin="6,0,6,0" Height="32" VerticalContentAlignment="Center"
                                             Padding="8,0" HintText="搜索收藏的资源名称、简介或来源 ID" />
                            <Grid Grid.Row="1" Height="32" Margin="6,4,6,0">
                                <local:MyCheckBox x:Name="CheckAll" Text="全选" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LabSummary" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource ColorBrushGray3}" Text="已选 0 项" />
                            </Grid>
                            <local:MyHint x:Name="HintEmpty" Theme="Blue" HasBorder="True" Visibility="Collapsed" Margin="6,8,6,8" Grid.Row="2"
                                          Text="还没有收藏的 Mod。在 Mod 下载列表里点击右侧的心形按钮即可收藏，收藏后会出现在这里，可以一键下载到任意版本。" />
                            <local:MyHint x:Name="HintSearchEmpty" Theme="Blue" HasBorder="True" Visibility="Collapsed" Margin="6,8,6,8" Grid.Row="2"
                                          Text="没有找到匹配的收藏，换个关键词试试。" />
                            <StackPanel x:Name="PanItems" Grid.Row="3" />
                        </Grid>
                    </Grid>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
