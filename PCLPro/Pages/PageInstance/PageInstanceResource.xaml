<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceResource"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,25">
            <local:MyCard x:Name="CardContent" Margin="0,0,0,15" Title="内容管理">
                <StackPanel Margin="25,40,25,15">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="截图" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabContentScreenshot" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <local:MyButton x:Name="BtnContentScreenshotOpen" Grid.Column="2" MinWidth="120" Text="打开文件夹"
                                        ToolTip="打开该版本的 screenshots 文件夹" />
                    </Grid>
                    <Grid Height="32" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="资源包" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabContentResourcePack" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <local:MyButton x:Name="BtnContentResourcePackOpen" Grid.Column="2" MinWidth="120" Text="打开文件夹"
                                        ToolTip="打开该版本的 resourcepacks 文件夹，把资源包放入后即可在游戏中启用" />
                    </Grid>
                    <Grid Height="32" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="光影包" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabContentShaderPack" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <local:MyButton x:Name="BtnContentShaderPackOpen" Grid.Column="2" MinWidth="120" Text="打开文件夹"
                                        ToolTip="打开该版本的 shaderpacks 文件夹，需要安装 Iris 或 OptiFine 才能生效" />
                    </Grid>
                    <Grid Height="32" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="投影原理图" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabContentSchematic" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnContentSchematicOpen" MinWidth="100" Text="打开文件夹"
                                            ToolTip="打开该版本的 schematics 文件夹" />
                            <local:MyButton x:Name="BtnContentSchematicPreview" MinWidth="90" Margin="10,0,0,0" Text="预览…" ColorType="Highlight"
                                            ToolTip="选择投影文件，读取其尺寸、名称与作者信息" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
