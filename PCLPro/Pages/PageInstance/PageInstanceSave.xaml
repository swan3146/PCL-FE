<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceSave"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10,25,25">
            <local:MyCard Margin="0,15,0,15" Title="存档管理">
                <StackPanel Margin="25,40,25,15">
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox x:Name="ComboSort" Grid.Column="1" Width="150" SelectedIndex="0">
                            <local:MyComboBoxItem Content="最近游玩" />
                            <local:MyComboBoxItem Content="游玩时长" />
                            <local:MyComboBoxItem Content="存档大小" />
                            <local:MyComboBoxItem Content="存档名称" />
                        </local:MyComboBox>
                        <local:MyRadioButton x:Name="BtnFilterAll" Grid.Column="2" Text="全部存档" ColorType="Highlight" Checked="True" Margin="18,0,4,0" />
                        <local:MyRadioButton x:Name="BtnFilterAbandoned" Grid.Column="3" Text="疑似废弃" ColorType="Highlight" Margin="4,0" />
                        <TextBlock x:Name="LabStatus" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource ColorBrushGray3}" Text="尚未扫描" />
                    </Grid>
                    <Grid Height="35" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnRefresh" Text="重新扫描" MinWidth="120" Padding="13,0" ColorType="Highlight" Margin="0,0,15,0" />
                        <local:MyButton x:Name="BtnOpenFolder" Grid.Column="1" Text="打开存档文件夹" MinWidth="140" Padding="13,0" />
                    </Grid>
                    <local:MyHint x:Name="HintEmpty" Theme="Blue" HasBorder="True" Visibility="Collapsed" Margin="0,12,0,0"
                                  Text="这个版本还没有存档。进入游戏创建一个世界后再回来看看吧。" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanItems" />
            <local:MyButton x:Name="BtnLoadMore" Text="加载更多" HorizontalAlignment="Center" Padding="24,0" Margin="0,4,0,10"
                            Visibility="Collapsed" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
