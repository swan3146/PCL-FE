<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherAbout"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15" Title="关于">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <local:MyListItem IsHitTestVisible="False" Title="PCL Pro" Margin="-5,0,15,0" Info="当前版本：%VERSION%（%VERSIONCODE%.%BRANCH%）" Grid.Column="1" x:Name="ItemAboutPcl" />
                    <Image Source="/Plain Craft Launcher Pro;component/Images/Heads/Logo.png" Margin="3">
                        <Image.Clip>
                            <EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" />
                        </Image.Clip>
                    </Image>
                    <local:MyButton Text="检查更新" Grid.Column="2" Height="35" x:Name="BtnAboutUpdate" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="特别鸣谢">
                <StackPanel Margin="25,42,23,18">
                    <TextBlock Text="PCL Pro 的诞生离不开 PCL 与其社区中这些玩家的贡献！" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" />
                    <TextBlock x:Name="LabThanks" LineHeight="24" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}"
                               Text="正在从 GitHub 获取贡献者名单……" />
                    <TextBlock Text="（名单由 GitHub 自动生成，排名不分先后）" Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource ColorBrushGray3}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="致谢与声明">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Margin="0,0,0,2" LineHeight="20" TextWrapping="Wrap"
                               Text="本项目（PCL Pro 修改版）是基于 PCL 公开源代码进行二次开发的第三方独立版本，包含了主线暂未制作的功能与改进。&#xa;&#xa;本项目并非由上游开发者龙腾猫跃开发与管理，且与龙腾猫跃本人及 PCL 官方无关。本项目版本号与 PCL 主线并非严格对应，请勿向 PCL 官方仓库反馈本版本的问题。&#xa;&#xa;本项目基于龙腾猫跃开发的 Plain Craft Launcher (PCL) 源代码进行二次创作，属于非官方修改版，声明如下：" />
                    <TextBlock Margin="10,10,0,2" LineHeight="22" TextWrapping="Wrap"
                               Text="• 原作者：龙腾猫跃&#xa;• 原项目仓库：https://github.com/Hex-Dragon/PCL2&#xa;• 本项目性质：第三方修改版，非官方版本，与龙腾猫跃本人无关。&#xa;• 许可协议：本项目继续沿用 PCL 的《合理使用指南》作为使用协议。" />
                    <TextBlock Margin="0,10,0,0" LineHeight="20" TextWrapping="Wrap"
                               Text="使用本项目即表示你已知悉：此为第三方二次开发版本，不保证可用性，其开发流程与管理与龙腾猫跃及原版 PCL 无关。" />
                    <StackPanel Orientation="Horizontal" Height="35" HorizontalAlignment="Left" Margin="0,14,0,0">
                        <local:MyButton Text="查看原项目仓库" Width="150" Padding="13,0" Margin="0,0,20,0"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://github.com/Hex-Dragon/PCL2" />
                        <local:MyButton Text="用户协议与免责声明" Width="180" Padding="13,0" Margin="0,0,20,0"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://shimo.im/docs/rGrd8pY8xWkt6ryW#anchor-RnU9" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
